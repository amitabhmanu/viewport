{
  "name": "viewport-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "build": "pnpm -r build",
    "eval": "tsx packages/eval/src/run.ts",
    "eval:grader": "tsx packages/eval/src/grader.ts",
    "eval:gate4": "tsx packages/eval/src/gate4.ts",
    "demo:video": "tsx packages/web/demo/record.ts demo-out"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
